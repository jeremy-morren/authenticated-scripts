{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ES2022",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "build",
    "rootDir": ".",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "tasks/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "test/**/*.ts"
  ]
}
